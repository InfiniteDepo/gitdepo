{{template "org/settings/layout_head" (dict "ctxData" . "pageClass" "organization settings branch-cleanup")}}
<div class="org-setting-content">
	<h4 class="ui top attached header">
		{{ctx.Locale.Tr "repo.settings.cleanup.preview_title"}} · {{ctx.Locale.Tr "repo.settings.cleanup.after_days" .PreviewDays}}
	</h4>
	<div class="ui attached segment">
		{{template "shared/branch_cleanup_notes" .}}
		<table class="ui very basic table" id="cleanup-repos">
			<thead><tr><th>{{ctx.Locale.Tr "repo.settings.cleanup.col_repo"}}</th><th>{{ctx.Locale.Tr "repo.settings.cleanup.col_would_delete"}}</th><th>{{ctx.Locale.Tr "repo.settings.cleanup.col_kept"}}</th></tr></thead>
			<tbody>
				{{range .Repos}}
				<tr>
					<td class="tw-break-anywhere"><a href="{{.Link}}">{{.Name}}</a></td>
					{{if .Off}}
					<td colspan="2">{{ctx.Locale.Tr "repo.settings.cleanup.own_off"}}</td>
					{{else if .Skip}}
					<td colspan="2">{{ctx.Locale.Tr "repo.settings.cleanup.skipped" .Skip}}</td>
					{{else}}
					<td>{{.Due}}{{if .Own}} ({{ctx.Locale.Tr "repo.settings.cleanup.own_days" .Days}}){{end}}</td>
					<td>{{.Kept}}</td>
					{{end}}
				</tr>
				{{end}}
			</tbody>
		</table>
		{{template "base/paginate" .}}
		<div class="tw-mt-4"><a class="ui button" href="{{.BackLink}}">{{ctx.Locale.Tr "repo.settings.delete_merged.back"}}</a></div>
	</div>
</div>
{{template "org/settings/layout_footer" .}}
