{{template "org/settings/layout_head" (dict "ctxData" . "pageClass" "organization settings branch-workflow")}}
<div class="org-setting-content">
	<h4 class="ui top attached header">
		{{ctx.Locale.Tr "org.settings.branch_workflow"}}
	</h4>
	<div class="ui attached segment">
		<form class="ui form" action="{{.OrgLink}}/settings/branch_workflow" method="post">
			<div class="field">
				<label for="delete_after_merge">{{ctx.Locale.Tr "repo.settings.branch_workflow.delete_after_merge"}}</label>
				<select id="delete_after_merge" name="delete_after_merge" class="ui dropdown">
					<option value="inherit" {{if eq .DeleteAfterMerge "inherit"}}selected{{end}}>{{ctx.Locale.Tr "org.settings.branch_workflow.inherit"}}</option>
					<option value="off" {{if eq .DeleteAfterMerge "off"}}selected{{end}}>{{ctx.Locale.Tr "repo.settings.branch_workflow.off"}}</option>
					<option value="default-on" {{if eq .DeleteAfterMerge "default-on"}}selected{{end}}>{{ctx.Locale.Tr "repo.settings.branch_workflow.default_on"}}</option>
					<option value="always" {{if eq .DeleteAfterMerge "always"}}selected{{end}}>{{ctx.Locale.Tr "repo.settings.branch_workflow.always"}}</option>
				</select>
				<p class="help">{{ctx.Locale.Tr "repo.settings.branch_workflow.delete_after_merge_desc"}}</p>
			</div>
			<div class="field">
				<div class="ui checkbox">
					<input id="enforce" name="enforce" type="checkbox" {{if .Enforce}}checked{{end}}>
					<label for="enforce">{{ctx.Locale.Tr "org.settings.branch_workflow.enforce"}}</label>
					<p class="help">{{ctx.Locale.Tr "org.settings.branch_workflow.enforce_desc"}}</p>
				</div>
			</div>
			<div class="field">
				<button class="ui primary button">{{ctx.Locale.Tr "save"}}</button>
			</div>
		</form>
	</div>
	<h4 class="ui top attached header" id="cleanup">
		{{ctx.Locale.Tr "repo.settings.cleanup"}}
	</h4>
	<div class="ui attached segment">
		<form class="ui form" action="{{.CleanupLink}}" method="post">
			<p>{{ctx.Locale.Tr "repo.settings.cleanup.desc"}}</p>
			<div class="field">
				<label for="cleanup_days">{{ctx.Locale.Tr "repo.settings.cleanup.days"}}</label>
				<input id="cleanup_days" name="days" type="number" min="0" max="3650" value="{{.CleanupDays}}">
				<p class="help">{{ctx.Locale.Tr "repo.settings.cleanup.days_help"}}</p>
			</div>
			<div class="field">
				<div class="ui checkbox">
					<input id="cleanup_enforce" name="enforce" type="checkbox" {{if .CleanupEnforce}}checked{{end}}>
					<label for="cleanup_enforce">{{ctx.Locale.Tr "org.settings.cleanup.enforce"}}</label>
					<p class="help">{{ctx.Locale.Tr "org.settings.cleanup.enforce_desc"}}</p>
				</div>
			</div>
			{{template "shared/branch_cleanup_status" .}}
			{{if .CleanupRepoCount}}<p>{{ctx.Locale.TrPluralString .CleanupRepoCount "org.settings.cleanup.repo_count" .CleanupRepoCount}}</p>{{end}}
			<div class="field">
				<button class="ui primary button">{{ctx.Locale.Tr "save"}}</button>
				<a class="ui button" href="{{.CleanupLink}}">{{ctx.Locale.Tr "repo.settings.cleanup.preview"}}</a>
			</div>
		</form>
	</div>
	<h4 class="ui top attached header" id="branching-model">
		{{ctx.Locale.Tr "repo.settings.branching_model"}}
	</h4>
	<div class="ui attached segment">
		<form class="ui form" action="{{.OrgLink}}/settings/branch_workflow/branching_model" method="post">
			<p>{{ctx.Locale.Tr "org.settings.branching_model.desc"}}</p>
			<div class="field">
				<label for="development_branch">{{ctx.Locale.Tr "repo.settings.branching_model.development_branch"}}</label>
				<input id="development_branch" name="development_branch" value="{{.DevelopmentBranch}}" maxlength="255">
				<p class="help">{{ctx.Locale.Tr "org.settings.branching_model.development_branch_desc"}}</p>
			</div>
			<div class="field">
				<label for="production_branch">{{ctx.Locale.Tr "repo.settings.branching_model.production_branch"}}</label>
				<input id="production_branch" name="production_branch" value="{{.ProductionBranch}}" placeholder="main" maxlength="255">
				<p class="help">{{ctx.Locale.Tr "repo.settings.branching_model.production_branch_desc"}}</p>
			</div>
			{{template "shared/branching_model_types" .}}
			{{template "shared/branching_model_naming" .}}
			<div class="field">
				<div class="ui checkbox">
					<input id="merge_forward" name="merge_forward" type="checkbox" {{if .MergeForward}}checked{{end}}>
					<label for="merge_forward">{{ctx.Locale.Tr "repo.settings.branching_model.merge_forward"}}</label>
					<p class="help">{{ctx.Locale.Tr "repo.settings.branching_model.merge_forward_desc"}}</p>
				</div>
			</div>
			<div class="field">
				<div class="ui checkbox">
					<input id="merge_forward_never_bypass" name="merge_forward_never_bypass" type="checkbox" {{if .MergeForwardNeverBypass}}checked{{end}}>
					<label for="merge_forward_never_bypass">{{ctx.Locale.Tr "repo.settings.branching_model.never_bypass"}}</label>
					<p class="help">{{ctx.Locale.Tr "repo.settings.branching_model.never_bypass_desc"}}</p>
				</div>
			</div>
			<div class="field">
				<div class="ui checkbox">
					<input id="merge_forward_anyone_may_skip" name="merge_forward_anyone_may_skip" type="checkbox" {{if .MergeForwardAnyoneMaySkip}}checked{{end}}>
					<label for="merge_forward_anyone_may_skip">{{ctx.Locale.Tr "repo.settings.branching_model.anyone_may_skip"}}</label>
					<p class="help">{{ctx.Locale.Tr "repo.settings.branching_model.anyone_may_skip_desc"}}</p>
				</div>
			</div>
			<div class="field">
				<div class="ui checkbox">
					<input id="enforce_model" name="enforce_model" type="checkbox" {{if .EnforceModel}}checked{{end}}>
					<label for="enforce_model">{{ctx.Locale.Tr "org.settings.branch_workflow.enforce"}}</label>
					<p class="help">{{ctx.Locale.Tr "org.settings.branching_model.enforce_desc"}}</p>
				</div>
			</div>
			<div class="field">
				<button class="ui primary button">{{ctx.Locale.Tr "save"}}</button>
			</div>
		</form>
	</div>
	{{template "shared/delete_merged_branches" .}}
</div>
{{template "org/settings/layout_footer" .}}
