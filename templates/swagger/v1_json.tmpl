            "$ref": "#/responses/error"
          },
          "403": {
            "$ref": "#/responses/forbidden"
          }
        }
      },
      "delete": {
        "description": "Remove completed (succeeded, failed, cancelled or skipped) workflow runs of the repository that are older than the given number of days, with their jobs, logs and artifacts. Kept runs, runs that are waiting or running and the latest run of each workflow on the default branch are never removed. At most 100 runs are removed per request; when \"more\" is true in the response, send the request again for the rest. Runs that have a job which has not finished are skipped and stay selected: stop when a response has \"deleted\" 0 and \"more\" true.\n",
        "produces": [
          "application/json"
        ],
        "tags": [
          "repository"
        ],
        "summary": "Delete the completed workflow runs older than a number of days.",
        "operationId": "DeleteOldActionRuns",
        "parameters": [
