    "/repos/{owner}/{repo}/secret-scanning/alerts/{index}/redact": {
      "post": {
        "description": "For people who may resolve the alert and read the issue or pull request (a token with scopes also needs write:issue). The secret is found again in the text as it is now and every copy of it is replaced with \"[secret removed]\"; the versions in the text's edit history are emptied (for a title, the secret is removed from the title changes of the timeline), the alert's places in the text are marked removed and the change is audited. When the secret is already gone from the text, only the history versions that hold it are emptied and the rest is done (204 too). Nobody is notified. It can't be undone, and the secret must still be revoked. A text the alert has no place in, or that the caller can't read, is 404; a text the detector can't read whole, an alert whose pattern is no longer used and a text with nothing left to remove are 422, a text that changed while it was redacted 409.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "repository"
        ],
        "summary": "Remove the secret of an alert from the text of an issue, pull request or comment",
        "operationId": "repoRedactSecretScanningText",
        "parameters": [
          {
            "type": "string",
            "description": "owner of the repo",
            "name": "owner",
            "in": "path",
            "required": true
          },
          {
            "type": "string",
            "description": "name of the repo",
            "name": "repo",
            "in": "path",
            "required": true
          },
          {
            "type": "integer",
            "format": "int64",
            "description": "number of the alert",
            "name": "index",
            "in": "path",
            "required": true
          },
          {
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/RedactSecretScanningTextOption"
            }
          }
        ],
        "responses": {
          "204": {
            "$ref": "#/responses/empty"
          },
          "403": {
            "$ref": "#/responses/forbidden"
          },
          "404": {
            "$ref": "#/responses/notFound"
          },
          "409": {
            "$ref": "#/responses/conflict"
          },
          "422": {
            "$ref": "#/responses/validationError"
