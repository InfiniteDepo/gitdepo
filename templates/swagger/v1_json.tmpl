    "/admin/audit": {
      "get": {
        "description": "Paged by ID (before_id, after_id) with a Link header and no total count. With format=csv or format=json every matching entry is exported, oldest first, with the X-Audit-* manifest headers.",
        "produces": [
          "application/json",
          "text/csv"
        ],
        "tags": [
          "admin"
        ],
        "summary": "List the audit log, newest first, or export it",
        "operationId": "adminListAuditEvents",
        "parameters": [
          {
            "type": "string",
            "description": "changes (default), signins, activity, all, or a comma-separated list of categories",
            "name": "category",
            "in": "query"
          },
          {
            "type": "string",
            "description": "organization name or ID",
            "name": "org",
            "in": "query"
          },
          {
            "type": "integer",
            "description": "project ID",
            "name": "project",
            "in": "query"
          },
          {
            "type": "string",
            "description": "repository full name (owner/[project/]name) or ID",
            "name": "repo",
            "in": "query"
          },
          {
            "type": "string",
            "description": "user name or ID (the acting user, the admin behind a sudo, or the account the entry concerns)",
            "name": "user",
            "in": "query"
          },
          {
            "type": "string",
            "description": "comma-separated credential types",
            "name": "credential_type",
            "in": "query"
          },
          {
            "type": "string",
            "description": "one credential, as type and ID separated by a colon",
            "name": "credential",
            "in": "query"
          },
          {
            "type": "string",
            "description": "user or organization name or ID owning the credential",
            "name": "credential_owner",
            "in": "query"
          },
          {
            "type": "string",
            "description": "catalog key, or a prefix ending in .*",
            "name": "action",
            "in": "query"
          },
          {
            "type": "string",
            "description": "success, failure or refused",
            "name": "result",
            "in": "query"
          },
          {
            "type": "string",
            "description": "client IP address",
            "name": "ip",
            "in": "query"
          },
          {
            "type": "string",
            "description": "request ID",
            "name": "request_id",
            "in": "query"
          },
          {
            "type": "string",
            "description": "RFC 3339 time, inclusive",
            "name": "since",
            "in": "query"
          },
          {
            "type": "string",
