{{if .CanTurnOn}}
<form class="ui form ignore-dirty tw-mt-4" action="{{.CleanupLink}}" method="post">
	<input type="hidden" name="cleanup_days" value="{{.PreviewDays}}">
	<p><strong>{{ctx.Locale.Tr "repo.settings.cleanup.days_input"}}:</strong> {{.PreviewDays}}</p>
	{{if .TurnOnStart}}<p>{{ctx.Locale.Tr "repo.settings.cleanup.turn_on_start" (.TurnOnStart.Format "2006-01-02 15:04 MST")}}</p>{{else}}<p>{{ctx.Locale.Tr "repo.settings.cleanup.turn_on_now"}}</p>{{end}}
	<button class="ui primary button">{{ctx.Locale.Tr "repo.settings.cleanup.turn_on" .PreviewDays}}</button>
</form>
{{end}}
