{{/* .ActionsReadOnly hides the buttons that change anything. .VariablesLink, .VariablesTitle and .VariablesDescription, if set, replace .Link and the default title: a page with both lists, such as an environment, sets them */}}
{{$link := or .VariablesLink .Link}}
<h4 class="ui top attached header">
	{{or .VariablesTitle (ctx.Locale.Tr "actions.variables.management")}}
	<div class="ui right">
		{{if not .ActionsReadOnly}}
		<button class="ui primary tiny button show-modal"
			data-modal="#edit-variable-modal"
			data-modal-form.action="{{$link}}/new"
			data-modal-header="{{ctx.Locale.Tr "actions.variables.creation"}}"
			data-modal-dialog-variable-name=""
			data-modal-dialog-variable-data=""
		>
			{{ctx.Locale.Tr "actions.variables.creation"}}
		</button>
		{{end}}
	</div>
</h4>
<div class="ui attached segment">
	{{if .VariablesDescription}}<p>{{.VariablesDescription}}</p>{{end}}
	{{if .Variables}}
	<div class="flex-list">
		{{range .Variables}}
		<div class="flex-item tw-items-center">
			<div class="flex-item-leading">
				{{svg "octicon-pencil" 32}}
			</div>
			<div class="flex-item-main">
				<div class="flex-item-title">
					{{.Name}}{{if and $.OverridesOrg (index $.OverridesOrg .Name)}} <span class="ui tiny label">{{ctx.Locale.Tr "repo_group.overrides_org"}}</span>{{else if and $.OverridesRepo (index $.OverridesRepo .Name)}} <span class="ui tiny label">{{ctx.Locale.Tr "actions.environments.overrides_repo"}}</span>{{end}}
				</div>
				<div class="flex-item-body">
					{{.Data}}
				</div>
			</div>
			<div class="flex-item-trailing">
				<span class="color-text-light-2">
					{{ctx.Locale.Tr "settings.added_on" (DateUtils.AbsoluteShort .CreatedUnix)}}
				</span>
				{{if not $.ActionsReadOnly}}
				<button class="btn interact-bg tw-p-2 show-modal"
					data-tooltip-content="{{ctx.Locale.Tr "actions.variables.edit"}}"
					data-modal="#edit-variable-modal"
					data-modal-form.action="{{$link}}/{{.ID}}/edit"
					data-modal-header="{{ctx.Locale.Tr "actions.variables.edit"}}"
					data-modal-dialog-variable-name="{{.Name}}"
					data-modal-dialog-variable-data="{{.Data}}"
				>
					{{svg "octicon-pencil"}}
				</button>
				<button class="btn interact-bg tw-p-2 link-action"
					data-tooltip-content="{{ctx.Locale.Tr "actions.variables.deletion"}}"
					data-url="{{$link}}/{{.ID}}/delete"
					data-modal-id="delete-variable"
				>
					{{svg "octicon-trash"}}
				</button>
				{{end}}
			</div>
		</div>
		{{end}}
	</div>
	{{else}}
		{{ctx.Locale.Tr "actions.variables.none"}}
	{{end}}
</div>

{{/** Edit variable dialog */}}
<dialog class="modal" id="edit-variable-modal">
	<article>
		<header></header>
		<form class="ui form form-fetch-action" method="post">
			<fieldset class="content">
				<div class="field">
					{{ctx.Locale.Tr "actions.variables.description"}}
				</div>
				<div class="field">
					<label for="dialog-variable-name">{{ctx.Locale.Tr "name"}}</label>
					<input autofocus required
						name="name"
						id="dialog-variable-name"
						aria-describedby="variable-name-description"
						value="{{.name}}"
						pattern="^(?!CI$)(?!FORGEJO_|GITEA_|GITHUB_)[a-zA-Z_][a-zA-Z0-9_]*$"
					>
					<p id="variable-name-description" class="help">{{ctx.Locale.Tr "actions.variables.mutation.name_description"}}</p>
				</div>
				<div class="field">
					<label for="dialog-variable-data">{{ctx.Locale.Tr "value"}}</label>
					<textarea required
						name="data"
						id="dialog-variable-data"
						aria-describedby="variable-data-description"
					></textarea>
					<p id="variable-data-description" class="help">{{ctx.Locale.Tr "actions.variables.mutation.value_description"}}</p>
				</div>
			</fieldset>
			{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
		</form>
		</article>
</dialog>

<dialog class="modal" id="delete-variable">
	<article>
		<div class="content">{{ctx.Locale.Tr "actions.variables.deletion.description"}}</div>
		<div class="actions">
			<button type="button" class="ui cancel button">{{ctx.Locale.Tr "settings.cancel"}}</button>
			<button class="ui primary button ok">{{ctx.Locale.Tr "modal.confirm"}}</button>
		</div>
	</article>
</dialog>
