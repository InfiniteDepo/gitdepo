{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content ui repository branches">
	{{template "repo/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}
		{{template "repo/sub_menu" .}}
		{{if .DefaultBranchBranch}}
			<h4 class="ui top attached header">
				{{ctx.Locale.Tr "repo.default_branch"}}
				{{if and $.Permission.IsAdmin (not $.Repository.IsArchived) (not .IsDeleted)}}
				<a role="button" class="right" href="{{.RepoLink}}/settings/branches" data-tooltip-content="{{ctx.Locale.Tr "repo.settings.branches.switch_default_branch"}}">
					{{svg "octicon-arrow-switch"}}
				</a>
				{{end}}
			</h4>

			<div class="ui attached table segment">
				<table class="ui very basic striped fixed table single line">
					<tbody>
						<tr>
							<td>
								<div class="flex-text-block">
									<a class="gt-ellipsis" href="{{.RepoLink}}/src/branch/{{PathEscapeSegments .DefaultBranchBranch.DBBranch.Name}}">{{.DefaultBranchBranch.DBBranch.Name}}</a>
									{{if .DefaultBranchBranch.IsProtected}}
										<span data-tooltip-content="{{ctx.Locale.Tr "repo.settings.protected_branch"}}">{{svg "octicon-shield-lock"}}</span>
									{{end}}
									{{if .DefaultBranchBranch.HasMergeQueue}}
										<a class="muted merge-queue-link" href="{{$.RepoLink}}/merge-queue/{{PathEscapeSegments .DefaultBranchBranch.DBBranch.Name}}" data-tooltip-content="{{ctx.Locale.Tr "repo.pulls.merge_queue.view"}}" aria-label="{{ctx.Locale.Tr "repo.pulls.merge_queue.view"}}">{{svg "octicon-git-merge-queue"}}</a>
									{{end}}
									<button class="btn interact-fg tw-px-1" data-clipboard-text="{{.DefaultBranchBranch.DBBranch.Name}}" data-tooltip-content="{{ctx.Locale.Tr "copy_branch"}}">{{svg "octicon-copy" 14}}</button>
									{{template "repo/commit_statuses" dict "Status" (index $.CommitStatus .DefaultBranchBranch.DBBranch.CommitID) "Statuses" (index $.CommitStatuses .DefaultBranchBranch.DBBranch.CommitID)}}
								</div>
								<p class="info tw-flex tw-items-center tw-my-1">{{svg "octicon-git-commit" 16 "tw-mr-1"}}<a href="{{.RepoLink}}/commit/{{PathEscape .DefaultBranchBranch.DBBranch.CommitID}}">{{ShortSha .DefaultBranchBranch.DBBranch.CommitID}}</a> · <span class="commit-message">{{RenderCommitMessage $.Context .DefaultBranchBranch.DBBranch.CommitMessage (.Repository.ComposeMetas ctx)}}</span> · {{ctx.Locale.Tr "org.repo_updated" (DateUtils.TimeSince .DefaultBranchBranch.DBBranch.CommitTime)}}{{if .DefaultBranchBranch.DBBranch.Pusher}} &nbsp;{{template "shared/user/avatarlink" dict "user" .DefaultBranchBranch.DBBranch.Pusher}}{{template "shared/user/namelink" .DefaultBranchBranch.DBBranch.Pusher}}{{end}}</p>
							</td>
							<td class="right aligned middle aligned overflow-visible">
								{{if and $.IsWriter (not $.Repository.IsArchived) (not $.Repository.IsMirror) (not .IsDeleted) (not $.PersonalRepoLocked)}}
									<button class="btn interact-bg show-create-branch-modal tw-p-2"
										data-branch-from="{{$.DefaultBranchBranch.DBBranch.Name}}"
										data-tooltip-content="{{ctx.Locale.Tr "repo.branch.new_branch_from" ($.DefaultBranchBranch.DBBranch.Name)}}"
									>
										{{svg "octicon-git-branch"}}
									</button>
								{{end}}
								{{if .EnableFeed}}
									<a role="button" class="btn interact-bg tw-p-2" href="{{$.FeedURL}}/rss/branch/{{PathEscapeSegments .DefaultBranchBranch.DBBranch.Name}}" data-tooltip-content="{{ctx.Locale.Tr "rss_feed"}}">{{svg "octicon-rss"}}</a>
								{{end}}
								{{if not $.DisableDownloadSourceArchives}}
									<div class="ui dropdown btn interact-bg tw-p-2" data-tooltip-content="{{ctx.Locale.Tr "repo.branch.download" ($.DefaultBranchBranch.DBBranch.Name)}}">
										{{svg "octicon-download"}}
										<div class="menu">
											<a class="item archive-link" href="{{$.RepoLink}}/archive/{{PathEscapeSegments $.DefaultBranchBranch.DBBranch.Name}}.zip" rel="nofollow">{{svg "octicon-file-zip"}}&nbsp;ZIP</a>
											<a class="item archive-link" href="{{$.RepoLink}}/archive/{{PathEscapeSegments $.DefaultBranchBranch.DBBranch.Name}}.tar.gz" rel="nofollow">{{svg "octicon-file-zip"}}&nbsp;TAR.GZ</a>
										</div>
									</div>
								{{end}}
								{{if and $.IsWriter (not $.Repository.IsArchived) (not .IsDeleted) (not $.IsMirror)}}
									<button class="btn interact-bg tw-p-2 show-rename-branch-modal"
										data-is-default-branch="true"
										data-old-branch-name="{{$.DefaultBranchBranch.DBBranch.Name}}"
										data-tooltip-content="{{ctx.Locale.Tr "repo.branch.rename" ($.DefaultBranchBranch.DBBranch.Name)}}"
									>
										{{svg "octicon-pencil"}}
									</button>
								{{end}}
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		{{end}}

		<h4 class="ui top attached header tw-flex tw-items-center tw-justify-between">
			<div class="tw-flex tw-items-center">
				{{ctx.Locale.Tr "repo.branches"}}
			</div>
			{{if and $.Permission.IsAdmin (not $.Repository.IsArchived) (not $.Repository.IsMirror)}}
				<a class="ui tiny button" href="{{.RepoLink}}/settings/branch_workflow/delete_merged#delete-merged">{{ctx.Locale.Tr "repo.settings.delete_merged"}}</a>
			{{end}}
		</h4>

		<div class="ui attached segment">
			<form class="ignore-dirty" method="get" id="branch-filters">
				{{template "shared/search/combo" dict "Value" .Keyword "Placeholder" (ctx.Locale.Tr "search.branch_kind")}}
				{{if .BranchFilter.Type}}<input type="hidden" name="type" value="{{.BranchFilter.Type}}">{{end}}
				{{if .BranchFilter.Untyped}}<input type="hidden" name="untyped" value="1">{{end}}
				<div class="flex-text-block tw-flex-wrap tw-mt-3">
					<label for="branch-filter-state">{{ctx.Locale.Tr "repo.branch.filter_state"}}</label>
					<select id="branch-filter-state" name="state">
						<option value="">{{ctx.Locale.Tr "repo.branch.filter_state_all"}}</option>
						<option value="merged"{{if eq .BranchFilter.State "merged"}} selected{{end}}>{{ctx.Locale.Tr "repo.branch.filter_state_merged"}}</option>
						<option value="not_merged"{{if eq .BranchFilter.State "not_merged"}} selected{{end}}>{{ctx.Locale.Tr "repo.branch.filter_state_not_merged"}}</option>
					</select>
					<label for="branch-filter-into">{{ctx.Locale.Tr "repo.branch.filter_into"}}</label>
					<select id="branch-filter-into" name="into">
						<option value="">{{ctx.Locale.Tr "repo.branch.filter_into_dev" .BranchDevelopment}}</option>
						{{if ne .BranchDevelopment .Repository.DefaultBranch}}<option value="default"{{if eq .BranchFilter.Into "default"}} selected{{end}}>{{ctx.Locale.Tr "repo.branch.filter_into_default" .Repository.DefaultBranch}}</option>{{end}}
					</select>
					<label for="branch-filter-stale" data-tooltip-content="{{ctx.Locale.Tr "repo.branch.filter_stale_tip"}}">{{ctx.Locale.Tr "repo.branch.filter_stale"}}</label>
					<input id="branch-filter-stale" name="stale" type="number" min="1" max="3650" class="tw-w-20" value="{{if gt .BranchFilter.StaleDays 0}}{{.BranchFilter.StaleDays}}{{end}}">
					<span>{{ctx.Locale.Tr "repo.branch.filter_stale_days"}}</span>
					<label for="branch-filter-pusher" data-tooltip-content="{{ctx.Locale.Tr "repo.branch.filter_pusher_tip"}}">{{ctx.Locale.Tr "repo.branch.filter_pusher"}}</label>
					<input id="branch-filter-pusher" type="search" name="pusher" value="{{.BranchFilter.PushedBy}}" placeholder="{{ctx.Locale.Tr "repo.branch.filter_pusher_placeholder"}}" autocomplete="off">
					{{if .IsSigned}}<a href="?pusher={{.SignedUser.Name}}">{{ctx.Locale.Tr "repo.branch.filter_mine"}}</a>{{end}}
					<label class="flex-text-block"><input type="checkbox" name="deleted" value="1"{{if .BranchFilter.Deleted}} checked{{end}}> {{ctx.Locale.Tr "repo.branch.filter_deleted"}}</label>
					<button class="ui small primary button">{{ctx.Locale.Tr "repo.branch.filter_apply"}}</button>
					{{if .BranchFilterSet}}<a href="{{.Link}}">{{ctx.Locale.Tr "repo.branch.filter_clear"}}</a>{{end}}
				</div>
			</form>
			{{if .HasBranchTypes}}
			<div class="flex-text-block tw-flex-wrap tw-mt-3" id="branch-type-filter">
				<span>{{ctx.Locale.Tr "repo.branch.filter_type"}}</span>
				<a class="ui small label {{if and (not .BranchTypeFilter) (not .BranchUntypedFilter)}}primary{{else}}basic{{end}}" href="?q={{.Keyword}}&{{.BranchFilterQuery}}">{{ctx.Locale.Tr "repo.branch.filter_all"}}</a>
				{{range .BranchTypeNames}}<a class="ui small label {{if eq $.BranchTypeFilter .}}primary{{else}}basic{{end}}" href="?q={{$.Keyword}}&type={{.}}&{{$.BranchFilterQuery}}">{{.}}</a>{{end}}
				<a class="ui small label {{if .BranchUntypedFilter}}primary{{else}}basic{{end}}" href="?q={{.Keyword}}&untyped=1&{{.BranchFilterQuery}}">{{ctx.Locale.Tr "repo.branch.no_type"}}</a>
				<button type="button" class="ui small basic button tw-ml-auto" id="branch-group-toggle" data-text-type="{{ctx.Locale.Tr "repo.branch.group_by_type"}}" data-text-none="{{ctx.Locale.Tr "repo.branch.group_by_none"}}"></button>
			</div>
			{{end}}
		</div>

		{{if .CanBulkDelete}}
		<div class="ui attached segment branch-bulk-bar" id="branch-bulk-bar" data-total="{{.BranchMatchingTotal}}" data-deleted="{{.BranchFilter.Deleted}}" data-preview-url="{{.Link}}/delete_preview" data-confirm-above="{{.BulkConfirmAbove}}" data-confirm-name="{{.BulkConfirmName}}"
			data-text-selected="{{ctx.Locale.Tr "repo.branch.bulk.selected" "%s"}}"
			data-text-select-all="{{ctx.Locale.Tr "repo.branch.bulk.select_all" "%s"}}"
			data-text-all-selected="{{ctx.Locale.Tr "repo.branch.bulk.all_selected" "%s"}}"
			data-text-delete="{{ctx.Locale.Tr "repo.branch.bulk.delete_n" "%s"}}"
			data-text-restore="{{ctx.Locale.Tr "repo.branch.bulk.restore_n" "%s"}}"
			data-title-one="{{ctx.Locale.TrPluralString 1 "repo.branch.bulk.title" "%s"}}" data-title-other="{{ctx.Locale.TrPluralString 2 "repo.branch.bulk.title" "%s"}}"
			data-ok-one="{{ctx.Locale.TrPluralString 1 "repo.branch.bulk.ok" "%s"}}" data-ok-other="{{ctx.Locale.TrPluralString 2 "repo.branch.bulk.ok" "%s"}}"
			data-text-cap="{{ctx.Locale.Tr "repo.branch.bulk.cap" "%s" "%s"}}"
			data-text-kept="{{ctx.Locale.Tr "repo.branch.bulk.kept_note" "%s"}}"
			data-text-none="{{ctx.Locale.Tr "repo.branch.bulk.none"}}"
			data-text-error="{{ctx.Locale.Tr "repo.branch.bulk.load_error"}}">
			<div class="flex-text-block tw-flex-wrap">
				<label class="flex-text-block branch-select-box"><input type="checkbox" id="branch-select-page" aria-label="{{ctx.Locale.Tr "repo.branch.bulk.select_page"}}"> <span id="branch-selected-count" aria-live="polite"></span></label>
				<button type="button" class="ui small basic button tw-hidden" id="branch-select-all"></button>
				<button type="button" class="ui small basic button tw-hidden" id="branch-clear-selection">{{ctx.Locale.Tr "repo.branch.bulk.clear"}}</button>
				{{if .BranchFilter.Deleted}}
				{{if not .PersonalRepoLocked}}<button class="ui small primary button tw-ml-auto" id="branch-restore-selected" form="restore-selected-form" disabled></button>{{end}}
				{{else}}
				<button type="button" class="ui small red button tw-ml-auto" id="branch-delete-selected" disabled></button>
				{{end}}
			</div>
		</div>
		{{if and .BranchFilter.Deleted (not .PersonalRepoLocked)}}<form id="restore-selected-form" method="post" action="{{.Link}}/restore_selected"></form>{{end}}
		{{end}}

		<div class="ui attached table segment">
			<table class="ui very basic striped fixed table single line">
				<tbody id="branch-list-body">
					{{range $group := .BranchGroups}}
					{{if $.HasBranchTypes}}
						<tr class="branch-group-header" data-group="{{$group.Name}}"><th colspan="5">{{if $group.Name}}{{$group.Name}}{{else}}{{ctx.Locale.Tr "repo.branch.no_type"}}{{end}}</th></tr>
					{{end}}
					{{range .Branches}}
						<tr data-order="{{.Order}}" data-group="{{$group.Name}}">
							{{if $.CanBulkDelete}}
							<td class="one wide branch-select-cell">
								{{if .DBBranch.IsDeleted}}
									{{if and $.BranchFilter.Deleted (not .IsProtected) (not $.PersonalRepoLocked)}}<input type="checkbox" class="branch-select" name="branch_id" form="restore-selected-form" value="{{.DBBranch.ID}}"{{if index $.SelectedNames .DBBranch.Name}} checked{{end}} aria-label="{{ctx.Locale.Tr "repo.branch.bulk.row_select" .DBBranch.Name}}">{{end}}
								{{else}}
									{{$kept := index $.KeptTexts .DBBranch.Name}}
									<input type="checkbox" class="branch-select" value="{{.DBBranch.CommitID}}:{{.DBBranch.Name}}" data-name="{{.DBBranch.Name}}"{{if $kept}} disabled aria-describedby="branch-kept-{{.Order}}"{{end}} aria-label="{{ctx.Locale.Tr "repo.branch.bulk.row_select" .DBBranch.Name}}">
								{{end}}
							</td>
							{{end}}
							<td class="{{if $.CanBulkDelete}}seven{{else}}eight{{end}} wide">
							{{if .DBBranch.IsDeleted}}
								<div class="flex-text-block">
									<span class="gt-ellipsis">{{.DBBranch.Name}}</span>
									<button class="btn interact-fg tw-px-1" data-clipboard-text="{{.DBBranch.Name}}" data-tooltip-content="{{ctx.Locale.Tr "copy_branch"}}">{{svg "octicon-copy" 14}}</button>
								</div>
								<p class="info">{{ctx.Locale.Tr "repo.branch.deleted_by" .DBBranch.DeletedBy.Name}} {{DateUtils.TimeSince .DBBranch.DeletedUnix}}</p>
							{{else}}
								<div class="flex-text-block">
									<a class="gt-ellipsis" href="{{$.RepoLink}}/src/branch/{{PathEscapeSegments .DBBranch.Name}}">{{.DBBranch.Name}}</a>
									{{if .IsProtected}}
										<span data-tooltip-content="{{ctx.Locale.Tr "repo.settings.protected_branch"}}">{{svg "octicon-shield-lock"}}</span>
									{{end}}
									{{if .HasMergeQueue}}
										<a class="muted merge-queue-link" href="{{$.RepoLink}}/merge-queue/{{PathEscapeSegments .DBBranch.Name}}" data-tooltip-content="{{ctx.Locale.Tr "repo.pulls.merge_queue.view"}}" aria-label="{{ctx.Locale.Tr "repo.pulls.merge_queue.view"}}">{{svg "octicon-git-merge-queue"}}</a>
									{{end}}
									<button class="btn interact-fg tw-px-1" data-clipboard-text="{{.DBBranch.Name}}" data-tooltip-content="{{ctx.Locale.Tr "copy_branch"}}">{{svg "octicon-copy" 14}}</button>
									{{template "repo/commit_statuses" dict "Status" (index $.CommitStatus .DBBranch.CommitID) "Statuses" (index $.CommitStatuses .DBBranch.CommitID)}}
								</div>
								<p class="info tw-flex tw-items-center tw-my-1">{{svg "octicon-git-commit" 16 "tw-mr-1"}}<a href="{{$.RepoLink}}/commit/{{PathEscape .DBBranch.CommitID}}">{{ShortSha .DBBranch.CommitID}}</a> · <span class="commit-message">{{RenderCommitMessage $.Context .DBBranch.CommitMessage ($.Repository.ComposeMetas ctx)}}</span> · {{ctx.Locale.Tr "org.repo_updated" (DateUtils.TimeSince .DBBranch.CommitTime)}}{{if .DBBranch.Pusher}} &nbsp;{{template "shared/user/avatarlink" dict "user" .DBBranch.Pusher}} &nbsp;{{template "shared/user/namelink" .DBBranch.Pusher}}{{end}}</p>
								{{if and $.CanBulkDelete (not $.BranchFilter.Deleted)}}{{$order := .Order}}{{with index $.KeptTexts .DBBranch.Name}}<p class="info tw-my-1" id="branch-kept-{{$order}}">{{ctx.Locale.Tr "repo.branch.bulk.kept_row" .}}</p>{{end}}{{end}}
							{{end}}
							</td>
							<td class="two wide ui">
								{{if and (not .DBBranch.IsDeleted) $.DefaultBranchBranch}}
								<div class="commit-divergence">
									<div class="bar-group">
										<div class="count count-behind">{{.CommitsBehind}}</div>
										{{/* old code bears 0/0.0 = NaN output, so it might output invalid "width: NaNpx", it just works and doesn't cause any problem. */}}
										<div class="bar bar-behind" style="width: {{Eval 100 "*" .CommitsBehind "/" "(" .CommitsBehind "+" .CommitsAhead "+" 0.0 ")"}}%"></div>
									</div>
									<div class="bar-group">
										<div class="count count-ahead">{{.CommitsAhead}}</div>
										<div class="bar bar-ahead" style="width: {{Eval 100 "*" .CommitsAhead "/" "(" .CommitsBehind "+" .CommitsAhead "+" 0.0 ")"}}%"></div>
									</div>
								</div>
								{{end}}
							</td>
							<td class="two wide right aligned">
								{{if not ($.Permission.CanRead $.UnitTypePullRequests)}}
									<a href="{{$.RepoLink}}/compare/{{if ne $.Repository.Owner.Name $.Owner.Name}}{{PathEscape $.Owner.Name}}:{{end}}{{PathEscapeSegments .DBBranch.Name}}">
										<button class="ui compact basic button tw-mr-0">{{ctx.Locale.Tr "compare.branches.title"}}</button>
									</a>
								{{else if not .LatestPullRequest}}
									{{if .IsIncluded}}
										<span class="ui orange large label" data-tooltip-content="{{ctx.Locale.Tr "repo.branch.included_desc"}}">
											{{svg "octicon-git-pull-request"}} {{ctx.Locale.Tr "repo.branch.included"}}
										</span>
									{{else if and (not .DBBranch.IsDeleted) $.AllowsPulls (gt .CommitsAhead 0)}}
									<a href="{{$.RepoLink}}/compare/{{if ne $.Repository.Owner.Name $.Owner.Name}}{{PathEscape $.Owner.Name}}:{{end}}{{PathEscapeSegments .DBBranch.Name}}">
										<button id="new-pull-request" class="ui compact basic button tw-mr-0">{{if $.CanPull}}{{ctx.Locale.Tr "repo.pulls.compare_changes"}}{{else}}{{ctx.Locale.Tr "action.compare_branch"}}{{end}}</button>
									</a>
									{{end}}
								{{else if and .LatestPullRequest.HasMerged .MergeMovedOn}}
									{{if and (not .DBBranch.IsDeleted) $.AllowsPulls (gt .CommitsAhead 0)}}
									<a href="{{$.RepoLink}}/compare/{{if ne $.Repository.Owner.Name $.Owner.Name}}{{PathEscape $.Owner.Name}}:{{end}}{{PathEscapeSegments .DBBranch.Name}}">
										<button id="new-pull-request" class="ui compact basic button tw-mr-0">{{if $.CanPull}}{{ctx.Locale.Tr "repo.pulls.compare_changes"}}{{else}}{{ctx.Locale.Tr "action.compare_branch"}}{{end}}</button>
									</a>
									{{end}}
								{{else}}
									<a href="{{.LatestPullRequest.Issue.Link}}" class="tw-align-middle ref-issue">{{if not .LatestPullRequest.IsSameRepo}}{{.LatestPullRequest.BaseRepo.FullName}}{{end}}#{{.LatestPullRequest.Issue.Index}}</a>
									{{if .LatestPullRequest.HasMerged}}
										<a href="{{.LatestPullRequest.Issue.Link}}" class="ui purple large label">{{svg "octicon-git-merge" 16 "tw-mr-1"}}{{ctx.Locale.Tr "repo.pulls.merged"}}</a>
									{{else if .LatestPullRequest.Issue.IsClosed}}
										<a href="{{.LatestPullRequest.Issue.Link}}" class="ui red large label">{{svg "octicon-git-pull-request-closed" 16 "tw-mr-1"}}{{ctx.Locale.Tr "repo.issues.closed_title"}}</a>
									{{else if .LatestPullRequest.IsWorkInProgress ctx}}
										<a href="{{.LatestPullRequest.Issue.Link}}" class="ui grey large label">{{svg "octicon-git-pull-request-draft" 16 "tw-mr-1"}}{{ctx.Locale.Tr "repo.issues.draft_title"}}</a>
									{{else}}
										<a href="{{.LatestPullRequest.Issue.Link}}" class="ui green large label">{{svg "octicon-git-pull-request" 16 "tw-mr-1"}}{{ctx.Locale.Tr "repo.issues.open_title"}}</a>
									{{end}}
								{{end}}
							</td>
							<td class="three wide right aligned overflow-visible">
								{{if and $.IsWriter (not $.Repository.IsArchived) (not $.Repository.IsMirror) (not .DBBranch.IsDeleted) (not $.PersonalRepoLocked)}}
									<button class="btn interact-bg tw-p-2 show-create-branch-modal"
										data-branch-from="{{.DBBranch.Name}}"
										data-tooltip-content="{{ctx.Locale.Tr "repo.branch.new_branch_from" .DBBranch.Name}}"
									>
										{{svg "octicon-git-branch"}}
									</button>
								{{end}}
								{{if $.EnableFeed}}
									<a role="button" class="btn interact-bg tw-p-2" href="{{$.FeedURL}}/rss/branch/{{PathEscapeSegments .DBBranch.Name}}" data-tooltip-content="{{ctx.Locale.Tr "rss_feed"}}">{{svg "octicon-rss"}}</a>
								{{end}}
								{{if and (not .DBBranch.IsDeleted) (not $.DisableDownloadSourceArchives)}}
									<div class="ui dropdown btn interact-bg tw-p-2" data-tooltip-content="{{ctx.Locale.Tr "repo.branch.download" (.DBBranch.Name)}}">
										{{svg "octicon-download"}}
										<div class="menu">
											<a class="item archive-link" href="{{$.RepoLink}}/archive/{{PathEscapeSegments .DBBranch.Name}}.zip" rel="nofollow">{{svg "octicon-file-zip"}}&nbsp;ZIP</a>
											<a class="item archive-link" href="{{$.RepoLink}}/archive/{{PathEscapeSegments .DBBranch.Name}}.tar.gz" rel="nofollow">{{svg "octicon-file-zip"}}&nbsp;TAR.GZ</a>
										</div>
									</div>
								{{end}}
								{{if and $.IsWriter (not $.Repository.IsArchived) (not .DBBranch.IsDeleted) (not $.IsMirror)}}
									<button class="btn interact-bg tw-p-2 show-rename-branch-modal"
										data-is-default-branch="false"
										data-old-branch-name="{{.DBBranch.Name}}"
										data-tooltip-content="{{ctx.Locale.Tr "repo.branch.rename" (.DBBranch.Name)}}"
									>
										{{svg "octicon-pencil"}}
									</button>
								{{end}}
								{{if and $.IsWriter (not $.IsMirror) (not $.Repository.IsArchived)}}
									{{if and .DBBranch.IsDeleted (not .IsProtected) (not $.PersonalRepoLocked)}}
										<button class="btn interact-bg tw-p-2 link-action restore-branch-button" data-url="{{$.Link}}/restore?branch_id={{.DBBranch.ID}}&name={{.DBBranch.Name}}&page={{$.Page.Paginater.Current}}" data-tooltip-content="{{ctx.Locale.Tr "repo.branch.restore" (.DBBranch.Name)}}">
											<span class="text blue">
												{{svg "octicon-reply"}}
											</span>
										</button>
									{{else if and (not .DBBranch.IsDeleted) .CanDelete}}
										<button class="btn interact-bg tw-p-2 delete-button delete-branch-button" data-url="{{$.Link}}/delete?name={{.DBBranch.Name}}&page={{$.Page.Paginater.Current}}" data-tooltip-content="{{ctx.Locale.Tr "repo.branch.delete" (.DBBranch.Name)}}" data-name="{{.DBBranch.Name}}" data-modal-id="delete-branch">
											{{svg "octicon-trash"}}
										</button>
									{{end}}
								{{end}}
							</td>
						</tr>
					{{end}}
					{{end}}
				</tbody>
			</table>
		</div>
		{{if and (not .Branches) .BranchFilterSet}}<p class="ui attached segment">{{ctx.Locale.Tr "repo.branch.filter_none"}}</p>{{end}}
		{{template "base/paginate" .}}
	</div>
</div>

<div class="ui g-modal-confirm delete modal" id="delete-branch">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "repo.branch.delete_html"}} <span class="name"></span>
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "repo.branch.delete_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>

{{if and (not .PersonalRepoLocked) .BranchDialog}}
{{template "repo/branch/create_dialog" .}}
{{end}}

{{if and .CanBulkDelete (not .BranchFilter.Deleted)}}
<dialog class="modal" id="delete-selected-modal" aria-labelledby="delete-selected-title">
	<article>
		<header id="delete-selected-title"></header>
		<form class="ui form" id="delete-selected-form" method="post" action="{{.Link}}/delete_selected">
			<div class="content">
				<p>{{ctx.Locale.Tr "repo.branch.bulk.intro"}} {{.RestoreText}}</p>
				<div class="ui warning message tw-hidden" id="delete-selected-cap"></div>
				<ul class="branch-delete-list" id="delete-selected-list" tabindex="0"></ul>
				<p class="info tw-hidden" id="delete-selected-kept"></p>
				<div class="field tw-hidden" id="delete-selected-confirm">
					<label for="delete-selected-name">{{ctx.Locale.Tr "repo.settings.delete_merged.confirm_name" .BulkConfirmName}}</label>
					<input id="delete-selected-name" name="confirm_name" autocomplete="off">
				</div>
				<p class="text red tw-hidden" id="delete-selected-error"></p>
			</div>
			<div class="actions">
				<button type="button" class="ui basic button" command="close" commandfor="delete-selected-modal">{{svg "octicon-x"}} {{ctx.Locale.Tr "cancel"}}</button>
				<button type="submit" class="ui red button" id="delete-selected-ok" disabled></button>
			</div>
		</form>
	</article>
</dialog>
{{end}}

<dialog class="modal" id="rename-branch-modal">
	<article>
		<header>{{ctx.Locale.Tr "repo.settings.rename_branch"}}</header>
		<div class="content default-branch-warning">
			<div class="ui warning message">{{ctx.Locale.Tr "repo.branch.warning_rename_default_branch"}}</div>
		</div>
		<form class="ui form" action="{{$.Repository.Link}}/settings/rename_branch" method="post">
			<div class="content">
				<input name="from" type="hidden" required>
				<div class="field">
					<span class="label-branch-from" data-locale="{{ctx.Locale.Tr "repo.branch.rename_branch_to"}}"></span>
				</div>
				<div class="required field">
					<label for="to_branch_name">{{ctx.Locale.Tr "repo.branch.name"}}</label>
					<input id="to_branch_name" name="to" required>
				</div>
			</div>
			{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
		</form>
	</article>
</dialog>
{{template "base/footer" .}}
