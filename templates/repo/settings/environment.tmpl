{{if .Repository}}{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings actions environments")}}{{else}}{{template "org/settings/layout_head" (dict "ctxData" . "pageClass" "organization settings actions environments")}}{{end}}
	<div class="{{if .Repository}}repo{{else}}org{{end}}-setting-content">
		{{$archived := .EnvironmentsArchived}}
		{{if and $archived .Repository}}
			<div class="ui warning message" id="environment-archived">{{ctx.Locale.Tr "actions.environments.archived"}}</div>
		{{end}}
		{{if .NoReviewer}}
			<div class="ui warning message" id="environment-no-reviewer">{{svg "octicon-alert"}} {{ctx.Locale.Tr "actions.environments.no_eligible_reviewer"}}</div>
		{{end}}
		<h4 class="ui top attached header">
			{{if .Environment}}{{ctx.Locale.Tr "actions.environments.edit_title" .Environment.Name}}{{else}}{{ctx.Locale.Tr "actions.environments.new"}}{{end}}
		</h4>
		<div class="ui attached segment">
			{{if not .Repository}}<div class="ui info message" id="environment-org-note">{{ctx.Locale.Tr "actions.environments.org.edit_desc" .EnvironmentOwner.Name}}</div>{{end}}
			<form class="ui form" id="environment-form" method="post" action="{{if .Environment}}{{.EnvironmentLink}}{{else}}{{.EnvironmentsLink}}/new{{end}}">
				{{if $archived}}<fieldset class="tw-contents" disabled>{{end}}
				<div class="field">
					<label for="environment-name">{{ctx.Locale.Tr "name"}}</label>
					<input id="environment-name" name="name" value="{{.Form.Name}}" maxlength="255" {{if .Environment}}readonly{{else}}required autofocus{{end}}>
					<p class="help">{{ctx.Locale.Tr "actions.environments.name.desc" (HTMLFormat "<code>%s</code>" (print "environment: " (or .Form.Name "production")))}}</p>
				</div>

				{{if not .Repository}}
				<div id="environment-repos">
					{{template "org/settings/deploy_key_scope" (dict "ctxData" $ "ID" "environment" "All" .Form.AllRepos "RepoIDs" .Form.RepoIDs)}}
					<p class="help">{{ctx.Locale.Tr "actions.environments.org.repos.desc"}}</p>
				</div>
				{{end}}
				<div class="field">
					<label for="environment-reviewers-input">{{ctx.Locale.Tr "actions.environments.reviewers"}}</label>
					<p class="help">{{if .ReviewerTeams}}{{ctx.Locale.Tr "actions.environments.reviewers.desc" .MaxReviewers}}{{else}}{{ctx.Locale.Tr "actions.environments.reviewers.desc_user" .MaxReviewers}}{{end}}</p>
					<div class="ui multiple search selection dropdown custom{{if $archived}} disabled{{end}}" id="environment-reviewers" data-max="{{.MaxReviewers}}">
						<input type="hidden" id="environment-reviewers-input" name="reviewers" value="{{.Form.Reviewers}}">
						<div class="default text">{{ctx.Locale.Tr "actions.environments.reviewers.placeholder"}}</div>
						<div class="menu">
							{{range .ReviewerOptions}}
								<div class="item{{if or .Unknown (and .Reason (ne .Reason "outsider"))}} environment-reviewer-ineligible{{end}}" data-value="{{.Key}}">
									{{if .Unknown}}{{svg "octicon-question"}} {{ctx.Locale.Tr "actions.environments.reviewer.unknown"}} <span class="help">{{ctx.Locale.Tr "actions.environments.reviewer.unknown.desc"}}</span>
									{{- else if .User}}{{ctx.AvatarUtils.Avatar .User 20 "mini"}}@{{.User.Name}}{{if .User.FullName}} <span class="text grey">{{.User.FullName}}</span>{{end}}
									{{- else}}{{svg "octicon-people"}} {{$.EnvironmentOwner.Name}}/{{.Team.Name}}{{end}}
									{{if .Reason}}
										<span class="help">
											{{if eq .Reason "not_usable"}}{{ctx.Locale.Tr "actions.environments.reviewer.not_usable"}}
											{{- else if eq .Reason "two_factor"}}{{ctx.Locale.Tr "actions.environments.reviewer.two_factor"}}
											{{- else if eq .Reason "none_in_team"}}{{ctx.Locale.Tr "actions.environments.reviewer.none_in_team"}}
											{{- else if eq .Reason "outsider"}}{{ctx.Locale.Tr "actions.environments.reviewer.outsider"}}
											{{- else}}{{ctx.Locale.Tr "actions.environments.reviewer.no_access"}}{{end}}
										</span>
									{{end}}
								</div>
							{{end}}
						</div>
					</div>
					<p class="help" id="environment-reviewers-count" data-text="{{ctx.Locale.Tr "actions.environments.reviewers.count"}}" data-full="{{ctx.Locale.Tr "actions.environments.reviewers.full"}}"></p>
				</div>
				<div class="field">
					<div class="ui checkbox">
						<input type="checkbox" id="environment-prevent-self-review" name="prevent_self_review" {{if .Form.PreventSelfReview}}checked{{end}}>
						<label for="environment-prevent-self-review">{{ctx.Locale.Tr "actions.environments.prevent_self_review"}}</label>
						<p class="help">{{ctx.Locale.Tr "actions.environments.prevent_self_review.desc"}}</p>
					</div>
				</div>

				<div class="field">
					<label for="environment-wait-timer">{{ctx.Locale.Tr "actions.environments.wait_timer"}}</label>
					<div class="tw-flex tw-items-center tw-gap-2">
						<input id="environment-wait-timer" name="wait_timer" type="number" min="0" max="{{.MaxWaitTimer}}" value="{{.Form.WaitTimer}}" class="tw-max-w-[12rem]">
						<span>{{ctx.Locale.Tr "actions.environments.wait_timer.minutes"}}</span>
					</div>
					<p class="help">{{ctx.Locale.Tr "actions.environments.wait_timer.desc" .MaxWaitTimer .MaxWaitTimerDays}}</p>
				</div>

				<div class="grouped fields" id="environment-ref-policy">
					<label>{{ctx.Locale.Tr "actions.environments.refs"}}</label>
					<div class="field">
						<div class="ui radio checkbox">
							<input type="radio" id="environment-ref-any" name="ref_policy" value="0" {{if eq .Form.RefPolicy 0}}checked{{end}}>
							<label for="environment-ref-any">{{ctx.Locale.Tr "actions.environments.refs.any"}}</label>
						</div>
					</div>
					<div class="field">
						<div class="ui radio checkbox">
							<input type="radio" id="environment-ref-protected" name="ref_policy" value="1" {{if eq .Form.RefPolicy 1}}checked{{end}}>
							<label for="environment-ref-protected">{{ctx.Locale.Tr "actions.environments.summary.protected_branches"}}</label>
							<p class="help">{{if .Repository}}{{ctx.Locale.Tr "actions.environments.refs.protected.desc"}}{{else}}{{ctx.Locale.Tr "actions.environments.refs.protected.org_desc"}}{{end}}</p>
						</div>
					</div>
					<div class="field">
						<div class="ui radio checkbox">
							<input type="radio" id="environment-ref-patterns" name="ref_policy" value="2" {{if eq .Form.RefPolicy 2}}checked{{end}}>
							<label for="environment-ref-patterns">{{ctx.Locale.Tr "actions.environments.refs.patterns"}}</label>
							<p class="help">{{ctx.Locale.Tr "actions.environments.refs.patterns.desc"}}</p>
						</div>
					</div>
					<div class="field tw-pl-8 {{if ne .Form.RefPolicy 2}}tw-hidden{{end}}" id="environment-patterns">
						<template id="environment-pattern-row">
							{{template "repo/settings/environment_pattern" .EmptyPattern}}
						</template>
						<div id="environment-pattern-rows">
							{{range .Form.Patterns}}{{template "repo/settings/environment_pattern" .}}{{end}}
						</div>
						<button type="button" class="ui small button" id="environment-pattern-add">{{svg "octicon-plus"}} {{ctx.Locale.Tr "actions.environments.refs.add"}}</button>
						<p class="help">{{ctx.Locale.Tr "actions.environments.refs.hint" (HTMLFormat "<code>*</code>") (HTMLFormat "<code>release/*</code>") (HTMLFormat "<code>release/2.4</code>") (HTMLFormat "<code>release/2.4/hotfix</code>") (HTMLFormat "<code>**</code>") (HTMLFormat "<code>/</code>") (HTMLFormat "<code>refs/heads/</code>")}}</p>
					</div>
				</div>

				<div class="field">
					<label for="environment-runner-labels">{{ctx.Locale.Tr "actions.environments.runner_labels"}}</label>
					<p class="help">{{ctx.Locale.Tr "actions.environments.runner_labels.desc"}}</p>
					<textarea id="environment-runner-labels" name="runner_labels" rows="2">{{.Form.RunnerLabels}}</textarea>
				</div>
				<div class="field">
					<label for="environment-allowed-workflows">{{ctx.Locale.Tr "actions.environments.allowed_workflows"}}</label>
					<p class="help">{{ctx.Locale.Tr "actions.environments.allowed_workflows.desc" (HTMLFormat "<code>deploy-*.yml</code>")}}</p>
					<textarea id="environment-allowed-workflows" name="allowed_workflows" rows="2">{{.Form.AllowedWorkflows}}</textarea>
				</div>

				{{if $archived}}</fieldset>{{else}}
				<div class="divider"></div>
				<div class="field">
					<button class="ui primary button" id="environment-save">{{if .Environment}}{{ctx.Locale.Tr "actions.environments.save"}}{{else}}{{ctx.Locale.Tr "actions.environments.create"}}{{end}}</button>
					<a class="ui button" href="{{.EnvironmentsLink}}">{{ctx.Locale.Tr "cancel"}}</a>
				</div>
				{{end}}
			</form>
		</div>

		{{if .Environment}}
			<div class="tw-mt-4" id="environment-secrets">{{template "shared/actions/secrets_list" .}}</div>
			<div class="tw-mt-4" id="environment-variables">{{template "shared/actions/variables_list" .}}</div>
			{{if not $archived}}

			<h4 class="ui top attached error header tw-mt-4">{{ctx.Locale.Tr "repo.settings.danger_zone"}}</h4>
			<div class="ui attached error danger segment">
				<div class="flex-list">
					<div class="flex-item">
						<div class="flex-item-main">
							<div class="flex-item-title">{{ctx.Locale.Tr "actions.environments.delete"}}</div>
							<div class="flex-item-body">{{if .Repository}}{{ctx.Locale.Tr "actions.environments.delete.desc"}}{{else}}{{ctx.Locale.Tr "actions.environments.org.delete.desc"}}{{end}}</div>
						</div>
						<div class="flex-item-trailing">
							<button class="danger button show-modal tw-whitespace-nowrap" data-modal="#delete-environment-modal">{{ctx.Locale.Tr "actions.environments.delete"}}</button>
						</div>
					</div>
				</div>
			</div>

			<dialog class="modal" id="delete-environment-modal">
				<article>
					<header>{{ctx.Locale.Tr "actions.environments.delete.title" .Environment.Name}}</header>
					<form class="ui form" method="post" action="{{.EnvironmentLink}}/delete">
						<div class="content">
							<p>{{if .Repository}}{{ctx.Locale.Tr "actions.environments.delete.confirm" .Environment.Name}}{{else}}{{ctx.Locale.Tr "actions.environments.org.delete.confirm" .EnvironmentOwner.Name .Environment.Name}}{{end}}</p>
							<p>
								{{ctx.Locale.Tr "actions.environments.delete.last"}}
								{{if .LastDeployment}}{{template "repo/settings/environment_deployment" .LastDeployment}}{{else}}{{ctx.Locale.Tr "actions.environments.delete.never"}}{{end}}
							</p>
							<div class="field">
								<label for="environment-delete-confirm">{{ctx.Locale.Tr "actions.environments.delete.type_name"}}</label>
								<input id="environment-delete-confirm" name="confirm_name" autocomplete="off" required data-name="{{.Environment.Name}}">
							</div>
						</div>
						<div class="actions">
							<button type="button" class="ui button" command="close" commandfor="delete-environment-modal">{{ctx.Locale.Tr "cancel"}}</button>
							<button class="ui red button" id="environment-delete-button" disabled>{{ctx.Locale.Tr "actions.environments.delete"}}</button>
						</div>
					</form>
				</article>
			</dialog>
			{{end}}
		{{end}}
	</div>
{{if .Repository}}{{template "repo/settings/layout_footer" .}}{{else}}{{template "org/settings/layout_footer" .}}{{end}}
