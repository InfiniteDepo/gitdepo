{{/* the merge styles of a branch rule; .Rule is the rule, .RepoConfig the repository's Pull requests setting (nil for organization and project rules) */}}
<fieldset id="merge-styles-settings">
	<legend>{{ctx.Locale.Tr "repo.settings.merge_styles.title"}}</legend>
	<p class="help">{{ctx.Locale.Tr "repo.settings.merge_styles.desc"}}</p>
	{{$rule := .Rule}}
	{{$cfg := .RepoConfig}}
	<div class="grouped fields">
		{{range $s := .Styles}}
		<div class="field">
			<div class="ui checkbox">
				<input id="allowed_merge_style_{{$s.Name}}" name="allowed_merge_styles" type="checkbox" value="{{$s.Name}}" {{if SliceUtils.Contains $rule.AllowedMergeStyles $s.Name}}checked{{end}}>
				<label for="allowed_merge_style_{{$s.Name}}">{{$s.Label}}</label>
				{{if and $cfg (not ($cfg.IsMergeStyleAllowed $s.Style))}}<p class="help">{{ctx.Locale.Tr "repo.settings.merge_styles.repo_off" $s.Label}}</p>{{end}}
			</div>
		</div>
		{{end}}
		<div class="field">
			<label for="default_merge_style">{{ctx.Locale.Tr "repo.settings.merge_styles.default"}}</label>
			<select id="default_merge_style" name="default_merge_style">
				<option value="" {{if not $rule.DefaultMergeStyle}}selected{{end}}>{{ctx.Locale.Tr "repo.settings.merge_styles.default_first"}}</option>
				{{range $s := .Styles}}
				<option value="{{$s.Name}}" {{if eq $rule.DefaultMergeStyle $s.Name}}selected{{end}}>{{$s.Label}}</option>
				{{end}}
			</select>
		</div>
	</div>
	<p class="help">{{ctx.Locale.Tr "repo.settings.merge_styles.manual_note"}}</p>
</fieldset>
